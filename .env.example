# Copy to .env.local. All business data in content/ must also be verified.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_INDEXABLE=false
NEXT_PUBLIC_STRUCTURED_DATA=false
NEXT_PUBLIC_FAQ_SCHEMA=false

# Keep false until original copy/assets, verified claims/contact details, service
# ZIPs, privacy text, legal consent, and media licenses have been approved.
CONTENT_APPROVED=false
# Set in every production deployment pipeline. Local build/start omit this.
# Known Vercel/Netlify production environments are also detected automatically.
DEPLOY_TARGET=preview

# No lead is delivered in demo mode. UI explicitly labels demo confirmations.
LEAD_MODE=demo
# For live delivery: CONTENT_APPROVED=true, LEAD_MODE=live, owned HTTPS endpoint.
# Receiver must honor Idempotency-Key (including retry after a timeout).
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=

# Optional request IP header overwritten by a trusted ingress, never a header
# clients can choose. Unset = one conservative shared request bucket.
# Current rate limiter and deduplication are single-process/in-memory:
# 30 requests per 15 minutes; successful keys retained 24 hours, at most 5000.
# Before scaling across instances or relying on durable deduplication, add an
# atomic shared rate-limit/idempotency store and ingress-level request limits.
LEAD_TRUSTED_IP_HEADER=

# Both off by default. Attribution additionally requires separate explicit
# browser consent; contact consent does not enable measurement.
NEXT_PUBLIC_ATTRIBUTION_ENABLED=false
# Hook only: emits glow:analytics CustomEvents to an approved local listener.
# No vendor script, destination, account, or tracker is bundled or configured.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
